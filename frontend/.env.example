# Frontend build-time configuration.
#
# Vite inlines these at BUILD time, not runtime — `npm run build` bakes whatever
# is set here into the bundle. Building without them silently falls back to the
# localhost defaults in src/services/api.ts, which produces a bundle that looks
# fine but sends every API call to the user's own machine.
#
# Copy to `.env` and fill in per environment:
#     cp .env.example .env
#
# `.env` is gitignored, so it must exist on whatever machine builds the bundle.

# Backend REST API (Django/gunicorn). Required.
# Production example: https://promtmaxxservice.rankmax.io
VITE_API_BASE_URL=http://localhost:8000

# Engine service (separate Django app, port 8001). Required.
# NOTE: browsers block plain http:// calls from an https:// page (mixed content),
# so in production this must be an https:// origin — point it at a TLS-terminating
# proxy rather than the raw host:8001.
VITE_ENGINE_URL=http://localhost:8001

# Optional. VITE_API_URL takes precedence over VITE_API_BASE_URL if both are set.
# VITE_API_URL=
