# Server-side only (never sent to the browser). The Next.js route handlers under
# /api/audits proxy to this backend, so the PivotRoots domain needs no CORS entry
# and the backend host is never exposed in page source. REQUIRED - there is no
# default, so a build cannot silently send test audits to production.
#   local stack:  http://localhost:8000
#   production:   https://promtmaxxservice.rankmax.io
AUDIT_API_URL=http://localhost:8000

# ISO 3166-1 alpha-2 market the audit's prompts and rankings run for when the
# link carries no ?m= parameter. PivotRoots' home markets are in / ae.
AUDIT_DEFAULT_COUNTRY=in

# Where "Talk to us" and the footer links go.
NEXT_PUBLIC_CONTACT_URL=https://www.pivotroots.com/contact

# Sub-path the page is served under, when it shares a domain with other apps
# (e.g. /pmx-landingpage). Empty = served at the root. Build-time: rebuild after
# changing it, and the proxy must pass the prefix through (no strip-path).
NEXT_PUBLIC_BASE_PATH=

# "Audit engine powered by PromptMaxx" line in the footer. Off = white-label.
NEXT_PUBLIC_SHOW_POWERED_BY=false
