# Promptmaxx MCP server configuration.
# Copy to .env (same directory) or export as environment variables.

# Base URL of the Promptmaxx backend.
PROMPTMAXX_BASE_URL=http://localhost:8000

# Login credentials. The server logs in itself and re-logs-in when the
# 8-hour access token expires. Single-process only: two MCP processes
# sharing one account race on the rotating refresh token.
PROMPTMAXX_EMAIL=development@digimaxx.co
PROMPTMAXX_PASSWORD=

# Optional: a ready-made access token. When set, the server uses it
# directly and only falls back to email/password login on a 401.
# Useful for testing without a password on disk.
#PROMPTMAXX_ACCESS_TOKEN=

# Opt-in: expose get_competitive_insights. Off by default because the
# endpoint generates false client-facing narrative from mis-extracted
# competitors (finding F12).
#PROMPTMAXX_MCP_ALLOW_INSIGHTS=0
