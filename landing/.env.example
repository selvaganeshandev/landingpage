# Landing-site build-time configuration (Next.js inlines NEXT_PUBLIC_* at build).
# Both default to the production hosts in code, so a build without this file
# still points at the live stack. Copy to .env.local for a local stack.

# Backend REST API — the free-audit form POSTs to <API_URL>/audits/
NEXT_PUBLIC_API_URL=https://promtmaxxservice.rankmax.io

# The app — visitors are sent to <APP_URL>/audit/<token> for their report
NEXT_PUBLIC_APP_URL=https://app.promptmaxx.co
